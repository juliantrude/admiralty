{
  "hooks": {
    "MessageDisplay": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--quiet", "--project", "${CLAUDE_PLUGIN_ROOT}", "admiralty", "hook", "display"],
            "timeout": 40
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--quiet", "--project", "${CLAUDE_PLUGIN_ROOT}", "admiralty", "hook", "stop"],
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--quiet", "--project", "${CLAUDE_PLUGIN_ROOT}", "admiralty", "hook", "pretooluse"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
