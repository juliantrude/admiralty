{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://admiralty.invalid/mechanics.schema.json",
  "title": "Mechanics Graph file (knowledge/<version>/graph/<domain>.yaml)",
  "description": "Shape of one domain file; cross-file rules (dangling links, facts, metrics, cycles) are checked by admiralty.graph.mechanics. See docs/plans/M4.md.",
  "type": "object",
  "required": ["version", "domain", "goals", "nodes"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "string", "pattern": "^v\\d+\\.\\d+(\\.\\d+)?$"},
    "domain": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "goals": {"type": "array", "items": {"$ref": "#/$defs/goal"}},
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z0-9_]+$"},
    "ids": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
    "fact_refs": {
      "description": "Generated fact ids; '*' wildcards allowed for families.",
      "type": "array",
      "items": {"type": "string", "pattern": "^[^\\s]+$"},
      "uniqueItems": true
    },
    "rule_refs": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
      "uniqueItems": true
    },
    "metric": {"type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z0-9_]+$"},
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "rating": {"enum": ["high", "medium", "low"]},
    "comparison": {
      "type": "object",
      "required": ["metric", "op", "compare_to"],
      "additionalProperties": false,
      "properties": {
        "metric": {"$ref": "#/$defs/metric"},
        "op": {"enum": ["<", "<=", ">", ">=", "==", "!="]},
        "only_clears": {
          "type": "boolean",
          "description": "The metric covers only part of the Obstacle (district slots of 'no district or building slot'): it can rule the Obstacle out, but where the comparison holds the rest is still judgement."
        },
        "compare_to": {
          "oneOf": [
            {"type": "number"},
            {
              "type": "object",
              "required": ["metric"],
              "additionalProperties": false,
              "properties": {"metric": {"$ref": "#/$defs/metric"}}
            }
          ]
        }
      }
    },
    "goal": {
      "type": "object",
      "required": ["id", "title", "causes"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"$ref": "#/$defs/text"},
        "symptom_metrics": {"type": "array", "items": {"$ref": "#/$defs/metric"}},
        "causes": {"allOf": [{"$ref": "#/$defs/ids"}, {"minItems": 1}]}
      }
    },
    "node": {
      "type": "object",
      "required": ["type"],
      "properties": {"type": {"enum": ["cause", "remedy", "obstacle"]}},
      "allOf": [
        {"if": {"required": ["type"], "properties": {"type": {"const": "cause"}}}, "then": {"$ref": "#/$defs/cause"}},
        {"if": {"required": ["type"], "properties": {"type": {"const": "remedy"}}}, "then": {"$ref": "#/$defs/remedy"}},
        {"if": {"required": ["type"], "properties": {"type": {"const": "obstacle"}}}, "then": {"$ref": "#/$defs/obstacle"}}
      ]
    },
    "cause": {
      "type": "object",
      "required": ["id", "type", "title", "description"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {"const": "cause"},
        "title": {"$ref": "#/$defs/text"},
        "description": {"$ref": "#/$defs/text"},
        "causes": {"$ref": "#/$defs/ids"},
        "remedies": {"$ref": "#/$defs/ids"},
        "facts": {"$ref": "#/$defs/fact_refs"},
        "rules": {"$ref": "#/$defs/rule_refs"},
        "circle": {"$ref": "#/$defs/text"},
        "break_point": {"type": "boolean"}
      }
    },
    "remedy": {
      "type": "object",
      "required": ["id", "type", "title", "judgement", "strength", "speed", "cost"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {"const": "remedy"},
        "title": {"$ref": "#/$defs/text"},
        "judgement": {"$ref": "#/$defs/text"},
        "strength": {"$ref": "#/$defs/rating"},
        "speed": {"$ref": "#/$defs/rating"},
        "cost": {"$ref": "#/$defs/rating"},
        "obstacles": {"$ref": "#/$defs/ids"},
        "facts": {"$ref": "#/$defs/fact_refs"},
        "rules": {"$ref": "#/$defs/rule_refs"},
        "pending_when": {"$ref": "#/$defs/comparison"},
        "circle": {"$ref": "#/$defs/text"},
        "break_point": {"type": "boolean"}
      }
    },
    "obstacle": {
      "type": "object",
      "required": ["id", "type", "title", "description", "check"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {"const": "obstacle"},
        "title": {"$ref": "#/$defs/text"},
        "uncertain_title": {"$ref": "#/$defs/text", "description": "The title in the conditional, shown when the Obstacle could not be checked against the numbers."},
        "description": {"$ref": "#/$defs/text"},
        "check": {
          "description": "Compared against the Snapshot by M5; judgement_only hands the Obstacle to the model, and the Briefing then says it was not checked against numbers.",
          "oneOf": [
            {"$ref": "#/$defs/comparison"},
            {
              "type": "object",
              "required": ["judgement_only"],
              "additionalProperties": false,
              "properties": {"judgement_only": {"const": true}}
            }
          ]
        },
        "remedies": {"$ref": "#/$defs/ids"},
        "facts": {"$ref": "#/$defs/fact_refs"},
        "rules": {"$ref": "#/$defs/rule_refs"},
        "circle": {"$ref": "#/$defs/text"},
        "break_point": {"type": "boolean"}
      }
    }
  }
}
