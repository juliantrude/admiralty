{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://admiralty.invalid/metrics.schema.json",
  "title": "Metrics registry (knowledge/<version>/graph/metrics.yaml)",
  "description": "Metric name -> where its value lives in the Snapshot extract. M4 delivers the paths, M5's expand_graph evaluates them.",
  "type": "object",
  "required": ["version", "metrics"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "string", "pattern": "^v\\d+\\.\\d+(\\.\\d+)?$"},
    "metrics": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*\\.[a-z0-9_]+$"},
      "additionalProperties": {"$ref": "#/$defs/metric"}
    }
  },
  "$defs": {
    "path": {
      "description": "Dotted path into the Snapshot extract document.",
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_]*(\\.[a-z_][a-z0-9_]*)*$"
    },
    "paths": {"type": "array", "items": {"$ref": "#/$defs/path"}, "minItems": 2, "uniqueItems": true},
    "unit": {"type": "string", "minLength": 1},
    "metric": {
      "description": "Exactly one of: path (a value), ratio (numerator / denominator), sum (of several values), contains (a label in a list).",
      "type": "object",
      "required": ["unit"],
      "additionalProperties": false,
      "properties": {
        "unit": {"$ref": "#/$defs/unit"},
        "path": {"$ref": "#/$defs/path"},
        "ratio": {
          "type": "object",
          "required": ["numerator", "denominator"],
          "additionalProperties": false,
          "properties": {
            "numerator": {"$ref": "#/$defs/path"},
            "denominator": {"$ref": "#/$defs/path"}
          }
        },
        "sum": {"$ref": "#/$defs/paths"},
        "contains": {
          "description": "1 when the label is in the list at the path (taken Ascension Perks, adopted Traditions), else 0; the list must exist in the extract. Labels are Display Names of the English game files.",
          "type": "object",
          "required": ["path", "label"],
          "additionalProperties": false,
          "properties": {"path": {"$ref": "#/$defs/path"}, "label": {"type": "string", "minLength": 1}}
        },
        "by_planet": {
          "description": "Path of the same value inside one entry of room.by_planet, for a value summed over the planets.",
          "$ref": "#/$defs/path"
        }
      },
      "oneOf": [{"required": ["path"]}, {"required": ["ratio"]}, {"required": ["sum"]}, {"required": ["contains"]}]
    }
  }
}
