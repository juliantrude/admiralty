{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://admiralty.invalid/solution.schema.json",
  "title": "Solution Graph (briefings/<in-game date>/solution-graph.json)",
  "description": "Shape of one Solution Graph, the only input M6 renders. Cross rules (graph nodes exist, edge grammar, reachability, Key Actions, rule ids) are checked by admiralty.graph.solution. See docs/plans/M5.md.",
  "type": "object",
  "required": ["schema", "game_version", "date", "empire", "nodes", "edges", "circles", "key_actions", "pruned"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": 1},
    "game_version": {"type": "string", "pattern": "^v\\d+\\.\\d+(\\.\\d+)?$"},
    "date": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "empire": {"$ref": "#/$defs/text"},
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
    "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
    "circles": {"type": "array", "items": {"$ref": "#/$defs/circle"}},
    "key_actions": {"type": "array", "items": {"$ref": "#/$defs/key_action"}},
    "excluded_key_actions": {"type": "array", "items": {"$ref": "#/$defs/reasoned"}},
    "pruned": {"type": "array", "items": {"$ref": "#/$defs/reasoned"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z0-9_]+$"},
    "ids": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
    "rating": {"enum": ["high", "medium", "low"]},
    "ratings": {
      "type": "object",
      "required": ["strength", "speed", "cost"],
      "additionalProperties": false,
      "properties": {
        "strength": {"$ref": "#/$defs/rating"},
        "speed": {"$ref": "#/$defs/rating"},
        "cost": {"$ref": "#/$defs/rating"}
      }
    },
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/text"}},
    "reasoned": {
      "type": "object",
      "required": ["id", "reason"],
      "additionalProperties": false,
      "properties": {"id": {"$ref": "#/$defs/id"}, "reason": {"$ref": "#/$defs/text"}}
    },
    "edge": {
      "type": "object",
      "required": ["from", "to", "kind"],
      "additionalProperties": false,
      "properties": {
        "from": {"$ref": "#/$defs/id"},
        "to": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["cause", "remedy", "obstacle"]},
        "weight": {"$ref": "#/$defs/rating"},
        "weight_reason": {"$ref": "#/$defs/text"}
      }
    },
    "circle": {
      "type": "object",
      "required": ["id", "members", "break_point"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/text"},
        "members": {"allOf": [{"$ref": "#/$defs/ids"}, {"minItems": 1}]},
        "break_point": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}
      }
    },
    "key_action": {
      "type": "object",
      "required": ["rank", "node", "serves", "unlocks", "why"],
      "additionalProperties": false,
      "properties": {
        "rank": {"type": "integer", "minimum": 1},
        "node": {"$ref": "#/$defs/id"},
        "serves": {"allOf": [{"$ref": "#/$defs/ids"}, {"minItems": 1}]},
        "unlocks": {"$ref": "#/$defs/ids"},
        "why": {"$ref": "#/$defs/text"}
      }
    },
    "node": {
      "type": "object",
      "required": ["source"],
      "properties": {"source": {"enum": ["graph", "model"]}},
      "allOf": [
        {"if": {"required": ["source"], "properties": {"source": {"const": "graph"}}}, "then": {"$ref": "#/$defs/graph_node"}},
        {"if": {"required": ["source"], "properties": {"source": {"const": "model"}}}, "then": {"$ref": "#/$defs/model_node"}}
      ]
    },
    "graph_node": {
      "description": "A node of the Mechanics Graph. Code computed status, check_state, ratings and the rule ids; the model wrote only horizon and crisis of a Goal.",
      "type": "object",
      "required": ["id", "type", "source", "title"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {"enum": ["goal", "cause", "remedy", "obstacle"]},
        "source": {"const": "graph"},
        "title": {"$ref": "#/$defs/text"},
        "text": {"$ref": "#/$defs/text"},
        "icon": {"type": "string", "pattern": "^data:image/png;base64,"},
        "horizon": {"enum": ["short", "medium", "long"]},
        "crisis": {"type": "boolean"},
        "mark": {"enum": ["up", "down", "flag"]},
        "status": {"enum": ["actionable", "pending", "obstructed"]},
        "ratings": {"$ref": "#/$defs/ratings"},
        "check_state": {"enum": ["present", "clear", "unknown", "judgement"]},
        "unresolved": {"const": true},
        "evidence": {"$ref": "#/$defs/evidence"},
        "rules": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}, "uniqueItems": true}
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "goal"}}, "required": ["type"]}, "then": {"required": ["horizon", "crisis", "mark"]}},
        {"if": {"properties": {"type": {"const": "remedy"}}, "required": ["type"]}, "then": {"required": ["status", "ratings"]}},
        {"if": {"properties": {"type": {"const": "obstacle"}}, "required": ["type"]}, "then": {"required": ["check_state"]}}
      ]
    },
    "model_node": {
      "description": "A node the model added. Marked by its id prefix and its reason; it carries no code-computed field.",
      "type": "object",
      "required": ["id", "type", "source", "title", "reason"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^model\\.[a-z0-9_]+$"},
        "type": {"enum": ["goal", "cause", "remedy", "obstacle"]},
        "source": {"const": "model"},
        "title": {"$ref": "#/$defs/text"},
        "reason": {"$ref": "#/$defs/text"},
        "horizon": {"enum": ["short", "medium", "long"]},
        "crisis": {"type": "boolean"},
        "mark": {"enum": ["up", "down", "flag"]},
        "empire": {"$ref": "#/$defs/text"},
        "flag": {"type": "string", "pattern": "^data:image/png;base64,"},
        "ratings": {"$ref": "#/$defs/ratings"},
        "unresolved": {"const": true},
        "evidence": {"$ref": "#/$defs/evidence"}
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "goal"}}, "required": ["type"]}, "then": {"required": ["horizon", "crisis", "mark"]}},
        {"if": {"required": ["flag"]}, "then": {"required": ["empire"]}}
      ]
    }
  }
}
